# ISOBAR environment
#
# Copy to `.env.local` and fill in. Every value here is read on the server
# only — nothing in this file is exposed to the browser, and no variable here
# is prefixed with NEXT_PUBLIC_ except where explicitly marked.
#
# The app runs with this file entirely empty. Open-Meteo, RainViewer, the NWS,
# MeteoAlarm, the NHC and OpenFreeMap all work without credentials; the
# optional keys below only unlock extra map layers.

# --- Optional -----------------------------------------------------------------

# OpenWeatherMap. Unlocks the temperature / wind / pressure / cloud map overlay
# layers and postal-code + reverse geocoding. Requests are proxied through
# /api/tiles/owm so the key is never sent to the browser.
# Get one at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# --- Recommended --------------------------------------------------------------

# The US National Weather Service requires a User-Agent identifying the caller.
# Requests still work without it but may be rate limited more aggressively.
NWS_CONTACT_EMAIL=

# Absolute origin, used for canonical URLs, OpenGraph images and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Development only ---------------------------------------------------------

# `mock` serves the bundled city fixtures instead of calling any network
# provider. Useful offline and in tests. Leave unset to use live data.
WEATHER_PROVIDER=

# Comma-separated list of subsystems to fail on purpose, for exercising the
# degraded states: air-quality, alerts, radar, storms, archive, forecast.
MOCK_FAILURE=
